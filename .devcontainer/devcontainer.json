// For format details, see https://aka.ms/devcontainer.json. For config options, see the reference:
// https://containers.dev/implementors/json_reference/
{
	"name": "Monolog-WP-CLI",
	"image": "mcr.microsoft.com/devcontainers/php:8.3",
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
		"ghcr.io/markheydon/devcontainer-features/copilot-likes:1": {}
	},
	"hostRequirements": {
		"cpus": 2,
		"memory": "8gb",
		"storage": "16gb"
	},
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	"containerEnv": {
		"COMPOSER_MEMORY_LIMIT": "-1",
		"XDEBUG_MODE": "off"
	},
	"customizations": {
		"vscode": {
			"settings": {
				"php.validate.executablePath": "/usr/local/bin/php",
				"php.debug.port": 9003
			},
			"extensions": [
				"bmewburn.vscode-intelephense-client",
				"recca0120.vscode-phpunit",
				"xdebug.php-debug",
				"ms-azuretools.vscode-containers"
			]
		}
	},
	"forwardPorts": [
		9003,
		8080,
		1313
	],
	"portsAttributes": {
		"9003": {
			"label": "Xdebug",
			"onAutoForward": "silent"
		},
		"8080": {
			"label": "WordPress smoke",
			"onAutoForward": "notify"
		},
		"1313": {
			"label": "Hugo dev server",
			"onAutoForward": "notify"
		}
	},
	"remoteUser": "vscode"
}
