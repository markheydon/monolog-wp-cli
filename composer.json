{
  "name": "mhcg/monolog-wp-cli",
  "description": "Extension for Monolog to support outputting to WP-CLI (The WordPress command line interface) when running wp command lines.",
  "keywords": [
    "log",
    "logging",
    "psr-3",
    "psr-12",
    "wp-cli"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Mark Heydon",
      "role": "Developer"
    }
  ],
  "type": "library",
  "extra": {
    "branch-alias": {
      "dev-main": "3.x-dev",
      "dev-upgrade-to-monolog3": "3.x-dev"
    }
  },
  "require": {
    "php": "^8.1",
    "monolog/monolog": "^3.0"
  },
  "require-dev": {
    "wp-cli/wp-cli": "^2.12",
    "phpunit/phpunit": "^8.5 || ^9.6 || ^12.5",
    "phpmd/phpmd": "^2.15",
    "squizlabs/php_codesniffer": "^3.13.6 || ^4.0.2"
  },
  "autoload": {
    "psr-4": {
      "MHCG\\Monolog\\": "src/Monolog"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MHCGDev\\Monolog\\": "tests/Monolog"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test:runtime-smoke": "php tests/runtime-smoke.php",
    "wp:env:up": "docker compose --project-directory tests/wordpress -f tests/wordpress/docker-compose.yml up -d db wordpress",
    "wp:env:down": "docker compose --project-directory tests/wordpress -f tests/wordpress/docker-compose.yml down -v",
    "test:wp:setup": "bash tests/wordpress/bin/setup-wordpress.sh",
    "test:wp:smoke": "bash tests/wordpress/bin/run-smoke.sh",
    "test:wp": [
      "@wp:env:up",
      "@test:wp:setup",
      "@test:wp:smoke"
    ],
    "lint:md": "php -d xdebug.mode=off vendor/bin/phpmd src text codesize,unusedcode",
    "lint:cs": "vendor/bin/phpcs",
    "lint": [
      "@lint:md",
      "@lint:cs"
    ],
    "qa": [
      "@test",
      "@lint"
    ]
  },
  "homepage": "https://markheydon.me.uk/monolog-wp-cli/",
  "support": {
    "issues": "https://github.com/markheydon/monolog-wp-cli/issues",
    "docs": "https://markheydon.me.uk/monolog-wp-cli/",
    "source": "https://github.com/markheydon/monolog-wp-cli"
  }
}
